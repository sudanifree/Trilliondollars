# Required for GitHub GraphQL repository details. Use a fine-grained or classic token
# with public repository read access; keep it on the API host, never in the browser.
# Multiple tokens may be comma- or space-separated for rate-limit rotation.
GITHUB_TOKEN=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://sudanifree.github.io,http://localhost:8443,http://127.0.0.1:8443
# Codespaces preview frontend origin pattern. Set empty to disable pattern matching.
CORS_ORIGIN_REGEX=https://[a-z0-9-]+-8443\.app\.github\.dev

# Optional GH Archive activity estimates through Google BigQuery.
# Requires ADC credentials and a Google Cloud project with BigQuery billing enabled.
GH_ARCHIVE_ENABLED=false
GH_ARCHIVE_PROJECT=
